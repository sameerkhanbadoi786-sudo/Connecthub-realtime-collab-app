# Copy this file to .env and fill in real values for production.
# Locally, it's fine to leave these unset - the app has safe dev defaults.

# Required in production (NODE_ENV=production). Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# development | production
NODE_ENV=development

PORT=3000

# Optional but recommended for real-world deployments: a TURN server.
# Without one, calls between peers on restrictive NATs/firewalls (common on
# corporate networks and some mobile carriers) may fail to connect - STUN
# alone isn't always enough. Leave unset to fall back to STUN-only.
# TURN_URL can be a single URL ("turn:turn.example.com:3478") or a
# comma-separated list if your provider gives you several.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Required in production: the real origin(s) your frontend is served from,
# e.g. "https://app.example.com" (comma-separated for more than one).
# Leaving this unset allows requests from ANY origin - fine for local dev,
# not for a public deployment.
CORS_ORIGIN=
